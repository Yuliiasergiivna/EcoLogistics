@model EcoLogistics.ViewModels.ClientBlock.PersonneContactFormViewModel

@{
    ViewData["Title"] = "Nouveau contact";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0 cf2d-card">
            <div class="card-header bg-cf2d-header text-white py-3">
                <h3 class="card-title h5 mb-0 fw-bold">
                    <i class="bi bi-person-plus-fill me-2"></i>Nouveau contact
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Id_client" class="form-label fw-bold"></label>
                        <select asp-for="Id_client" asp-items="Model.ClientList" class="form-select">
                            <option value="">-- Sélectionnez un client --</option>
                        </select>
                        <span asp-validation-for="Id_client" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Nom" class="form-label fw-bold"></label>
                            <input asp-for="Nom" class="form-control" />
                            <span asp-validation-for="Nom" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Prenom" class="form-label fw-bold"></label>
                            <input asp-for="Prenom" class="form-control" />
                            <span asp-validation-for="Prenom" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Telephone" class="form-label fw-bold"></label>
                            <input asp-for="Telephone" class="form-control" />
                            <span asp-validation-for="Telephone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gsm" class="form-label fw-bold"></label>
                            <input asp-for="Gsm" class="form-control" />
                            <span asp-validation-for="Gsm" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Id_localite" class="form-label fw-bold"></label>
                        <select asp-for="Id_localite" asp-items="Model.LocaliteList" class="form-select">
                            <option value="">-- Sélectionnez une localité (optionnel) --</option>
                        </select>
                        <span asp-validation-for="Id_localite" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Retour
                        </a>
                        <button type="submit" class="btn btn-cf2d fw-bold">
                            <i class="bi bi-check-lg me-1"></i>Enregistrer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}