@model IEnumerable<EcoLogistics.ViewModels.UserBlock.DonneesPersoListViewModel>

@{
    ViewData["Title"] = "Liste des données personnelles";
    var actifs = Model.Where(x => x.IsActive).ToList();
    var inactifs = Model.Where(x => !x.IsActive).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 fw-bold text-dark">
        <i class="bi bi-people-fill text-primary me-2"></i>Données personnelles
    </h2>
    <a asp-controller="Account" asp-action="Register" class="btn btn-cf2d fw-bold">
        <i class="bi bi-person-plus-fill text-cf2d me-2"></i>Ajouter un utilisateur
    </a>
</div>

<!-- 1. TABLEAU DES EMPLOYÉS ACTIFS -->
<div class="card shadow-lg border-0 cf2d-card mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold " style="color: var(--cf2d-green)">
            <i class="bi bi-check-circle-fill me-2"></i>Employés actifs (@actifs.Count)
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-cf2d-header text-white">
                    <tr>
                        <th>Nom & Prénom</th>
                        <th>Poste</th>
                        <th>Localité</th>
                        <th>Statut</th>
                        <th class="text-end px-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!actifs.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-3 text-muted">Aucun employé actif trouvé.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in actifs)
                        {
                            <tr>
                                <td class="fw-bold">@item.Nom @item.Prenom</td>
                                <td>@(item.Poste ?? "—")</td>
                                <td>@item.Nom_localite</td>
                                <td><span class="badge bg-success">@item.Statut</span></td>
                                <td class="text-end px-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id_perso" class="btn btn-outline-cf2d" title="Voir détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id_perso" class="btn btn-outline-warning" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@item.Id_perso" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Désactiver / Licencier" onclick="return confirm('Voulez-vous vraiment désactiver cet utilisateur ?');">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                                    </div>
 @*                                    <a asp-action="Details" asp-route-id="@item.Id_perso" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>Voir détails
                                    </a> *@
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 2. BOUTON ET SECTION POUR LES EMPLOYÉS LICENCIÉS-->
<div class="mb-3">
    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#inactifsCollapse" aria-expanded="false" aria-controls="inactifsCollapse">
        <i class="bi bi-archive-fill me-1"></i> Afficher / Masquer les anciens employés (@inactifs.Count)
    </button>
</div>

<div class="collapse" id="inactifsCollapse">
    <div class="card shadow-lg border-0 cf2d-card bg-light">
        <div class="card-header bg-cf2d-header text-white py-2">
            <h6 class="card-title mb-0">
                <i class="bi bi-person-x-fill me-2"></i>Historique - Employés inactifs
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-muted">
                    <thead class="table-secondary">
                        <tr>
                            <th>Nom & Prénom</th>
                            <th>Poste</th>
                            <th>Localité</th>
                            <th>Statut</th>
                            <th class="text-end px-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!inactifs.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-3">Aucun ancien employé enregistré.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in inactifs)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Nom @item.Prenom</td>
                                    <td>@(item.Poste ?? "—")</td>
                                    <td>@item.Nom_localite</td>
                                    <td><span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">@(item.IsActive ? (string.IsNullOrEmpty(item.Statut) ? "Actif" : item.Statut) : "Inactif")</span>
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id_perso" class="btn btn-outline-secondary" title="Voir détails">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id_perso" class="btn btn-outline-warning" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.Id_perso" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Réactiver le compte" onclick="return confirm('Voulez-vous réactiver cet utilisateur ?');">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        </div>
@*                                         <a asp-action="Details" asp-route-id="@item.Id_perso" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye me-1"></i>Voir détails
                                        </a> *@
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>