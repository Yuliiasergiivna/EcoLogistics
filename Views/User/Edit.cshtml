@model EcoLogistics.ViewModels.UserBlock.UserEditViewModel

@{
    ViewData["Title"] = "Modifier l'utilisateur";
}

<div class="container mt-4">
    <div class="card shadow-lg cf2d-card overflow-hidden">
        <div class="card-header bg-cf2d-header py-3 px-4">
            <h2 class="h4 mb-0"><i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]</h2>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id_user" />
                <input type="hidden" asp-for="Id_perso" />

                <!-- Compte utilisateur -->
                <h5 class="text-cf2d border-bottom pb-2">Compte Utilisateur</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Nickname" class="form-label fw-bold"></label>
                        <input asp-for="Nickname" class="form-control" />
                        <span asp-validation-for="Nickname" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-bold"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                            <option value="Manager">Manager</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsUserActive" id="IsUserActiveSwitch">
                            <label class="form-check-label fw-bold" for="IsUserActiveSwitch">Compte Actif</label>
                        </div>
                    </div>
                </div>

                <!-- Données personnelles -->
                <h5 class="text-cf2d border-bottom pb-2 mt-4">Données Personnelles</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Nom" class="form-label fw-bold"></label>
                        <input asp-for="Nom" class="form-control" />
                        <span asp-validation-for="Nom" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Prenom" class="form-label fw-bold"></label>
                        <input asp-for="Prenom" class="form-control" />
                        <span asp-validation-for="Prenom" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Poste" class="form-label fw-bold"></label>
                        <input asp-for="Poste" class="form-control" />
                        <span asp-validation-for="Poste" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Statut" class="form-label fw-bold"></label>
                        <select asp-for="Statut" class="form-select">
                            <option value="Actif">Actif</option>
                            <option value="Licencié">Licencié</option>
                    @*         <option value="En congé">En congé</option> *@
                        </select>
                        <span asp-validation-for="Statut" class="text-danger"></span>
                    </div>
                </div>

                <!-- Adresse -->
                <h5 class="text-cf2d border-bottom pb-2 mt-4">Localisation</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Adresse" class="form-label fw-bold"></label>
                        <input asp-for="Adresse" class="form-control" />
                        <span asp-validation-for="Adresse" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Id_localite" class="form-label fw-bold"></label>
                        <select asp-for="Id_localite" asp-items="ViewBag.Localites" class="form-select">
                            <option value="">-- Sélectionner une localité --</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                    <a asp-action="Profile" class="btn btn-secondary me-2">Annuler</a>
                    <button type="submit" class="btn btn-cf2d px-4 fw-bold"><i class="bi bi-save me-1"></i>Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>