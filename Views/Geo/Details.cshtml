@model EcoLogistics.ViewModels.Geo.GeoDetailsViewModel

@{
    ViewData["Title"] = "Détails géographiques";
}



<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg cf2d-card mb-4">

                <!-- Card Header -->
                <div class="card-header bg-cf2d-header py-3 px-4 d-flex justify-content-between align-items-center">
                    <h2 class="h4 mb-0 fw-bold text-white">
                        <i class="bi bi-geo-alt-fill me-2"></i>Détails géographiques
                    </h2>
                    <span class="badge bg-white text-dark fw-bold">@Model.Nom_localite</span>
                </div>

                <div class="card-body p-4 p-md-5">

                    <!-- Section 1: Localité -->
                    <div class="mb-4">
                        <h4 class="h5 text-cf2d border-bottom pb-2 fw-bold mb-3">
                            <i class="bi bi-building me-2"></i>Localité
                        </h4>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="cf2d-label">@Html.DisplayNameFor(model => model.Nom_localite)</div>
                                <div class="cf2d-value">@(Model.Nom_localite ?? "—")</div>
                            </div>
                            <div class="col-md-4">
                                <div class="cf2d-label">@Html.DisplayNameFor(model => model.Code_postal)</div>
                                <div class="cf2d-value">
                                    <span class="badge bg-light text-dark border">@(Model.Code_postal ?? "—")</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="cf2d-label">@Html.DisplayNameFor(model => model.Province)</div>
                                <div class="cf2d-value">@(Model.Province ?? "—")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Pays -->
                    <div class="mb-4">
                        <h4 class="h5 text-cf2d border-bottom pb-2 fw-bold mb-3">
                            <i class="bi bi-globe me-2"></i>Pays
                        </h4>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="cf2d-label">@Html.DisplayNameFor(model => model.Nom_pays)</div>
                                <div class="cf2d-value">@(Model.Nom_pays ?? "—")</div>
                            </div>
                            <div class="col-md-6">
                                <div class="cf2d-label">@Html.DisplayNameFor(model => model.Code_ISO)</div>
                                <div class="cf2d-value">
                                    <span class="badge bg-secondary">@(Model.Code_ISO ?? "—")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Commune BXL (Optionnel) -->
                    @if (Model.Id_commune.HasValue)
                    {
                        <div class="mb-4">
                            <h4 class="h5 text-cf2d border-bottom pb-2 fw-boldmb-3">
                                <i class="bi bi-map me-2"></i>Informations Commune (Bruxelles)
                            </h4>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="cf2d-label">@Html.DisplayNameFor(model => model.Commune_principale)</div>
                                    <div class="cf2d-value">@(Model.Commune_principale ?? "—")</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="cf2d-label">@Html.DisplayNameFor(model => model.Type)</div>
                                    <div class="cf2d-value">@(Model.Type ?? "—")</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="cf2d-label">@Html.DisplayNameFor(model => model.Nom_fr)</div>
                                    <div class="cf2d-value">@(Model.Nom_fr ?? "—")</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="cf2d-label">@Html.DisplayNameFor(model => model.Nom_nl)</div>
                                    <div class="cf2d-value">@(Model.Nom_nl ?? "—")</div>
                                </div>
                                <div class="col-md-12">
                                    <div class="cf2d-label">@Html.DisplayNameFor(model => model.Sous_commune)</div>
                                    <div class="cf2d-value">
                                        @if (Model.Sous_commune)
                                        {
                                            <span class="badge bg-success">Oui</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Non</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>

                <!-- Footer / Actions -->
                <div class="card-footer bg-light px-4 py-3 d-flex justify-content-between rounded-bottom-4">
                    <a asp-action="Index" class="btn btn-cf2d px-4">
                        <i class="bi bi-arrow-left me-1"></i>Retour à la liste
                    </a>

@*                     @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id_localite" class="btn btn-cf2d-blue px-4">
                            <i class="bi bi-pencil me-1"></i>Modifier
                        </a>
                    } *@
                </div>

            </div>
        </div>
    </div>
</div>
