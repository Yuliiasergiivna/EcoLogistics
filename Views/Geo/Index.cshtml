@model EcoLogistics.ViewModels.Geo.GeoIndexViewModel

@{
    ViewData["Title"] = "Gestion Géographique";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 fw-bold text-dark">
        <i class="bi bi-geo-alt-fill text-cf2d me-2"></i>Liste des Localités & Pays
    </h2>
</div>
    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="geoTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="localites-tab" data-bs-toggle="tab" data-bs-target="#localites" type="button" role="tab">
                <i class="bi bi-building me-2"></i>Localités
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="communes-tab" data-bs-toggle="tab" data-bs-target="#communes" type="button" role="tab">
                <i class="bi bi-map me-2"></i>Communes (BXL)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="pays-tab" data-bs-toggle="tab" data-bs-target="#pays" type="button" role="tab">
                <i class="bi bi-globe me-2"></i>Pays
            </button>
        </li>
    </ul>

    <!-- Content Tabs -->
    <div class="tab-content" id="geoTabsContent">

        <!-- Tab 1: Localités -->
        <div class="tab-pane fade show active" id="localites" role="tabpanel">
            <div class="card shadow-lg cf2d-card border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-cf2d-header">
                                <tr>
                                    <th>Nom Localité</th>
                                    <th>Code Postal</th>
                                    <th>Province</th>
                                    <th>Pays</th>
                                    <th>Commune (BXL)</th>
                                    <th class="text-end px-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Localites)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.Nom_localite</td>
                                        <td><span class="badge bg-light text-dark border">@item.Code_postal</span></td>
                                        <td>@(item.Province ?? "—")</td>
                                        <td>
                                            <span class="badge" style="background-color: var(--cf2d-blue);">
                                                @(item.Pays?.Nom_pays ?? "Non défini")
                                            </span>
                                        </td>
                                        <td>@(item.CommuneBXL?.Commune_principale ?? "—")</td>
                                        <td class="text-end px-4">
                                            <a asp-action="Details" asp-route-id="@item.Id_localite" class="btn btn-sm btn-outline-info" title="Détails">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: Communes (BXL) -->
        <div class="tab-pane fade" id="communes" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-cf2d-header">
                                <tr>
                                    <th>Commune principale</th>
                                    <th>Nom FR</th>
                                    <th>Nom NL</th>
                                    <th>Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Communes)
                                {
                                    <tr>
                                        <td class="fw-bold">@c.Commune_principale</td>
                                        <td>@c.Nom_fr</td>
                                        <td>@c.Nom_nl</td>
                                        <td><span class="badge bg-secondary">@c.Type</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 3: Pays -->
        <div class="tab-pane fade" id="pays" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-cf2d-header">
                                <tr>
                                    <th style="width: 300px;">Nom du Pays</th>
                                    <th>Code ISO</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PaysList)
                                {
                                    <tr>
                                    <td class="fw-bold">@p.Nom_pays</td>
                                    <td><span class="badge bg-light text-dark border fw-bold">@p.Code_ISO</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
