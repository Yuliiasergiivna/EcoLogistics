@model EcoLogistics.ViewModels.Geo.GeoIndexViewModel

@{
    ViewData["Title"] = "Gestion Géographique";
}


<!-- Tab 1: Localités -->
<div class="tab-pane fade show active" id="localites" role="tabpanel">

    <div class="card shadow-lg cf2d-card border-0 position-relative" style="height:calc(100vh - 220px);">
        <div class="card-body p-0 d-flex fleh-column h-100 overflow-hidden" >

            <!-- Konteyner s fiksirovannoy shapkoy i skrollom tolko dlya tbody -->
            <div class="table-responsive flex-grow-1 h-100" style=" overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-cf2d-header text-white" style="position: sticky; top: 0; z-index: 10;">
                        <tr>
                            <th class="py-3 ps-4">
                                Nom Localité
                                <span class="ms-1 text-white-50" style="font-size: 0.8rem;">

                                </span>
                            </th>
                            <th class="py-3">
                                Code Postal
                                <span class="ms-1 text-white-50" style="font-size: 0.8rem;">
          
                                </span>
                            </th>
                            <th class="py-3 pe-4">
                                Pays
                                <span class="ms-1 text-white-50" style="font-size: 0.8rem;">
                        
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Localites)
                        {
                            <tr style="cursor: pointer;" onclick="window.location='@Url.Action("Details", new { id = item.Id_localite })'">
                                <td class="fw-bold ps-4">@item.Nom_localite</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.Code_postal</span>
                                </td>
                                <td class="pe-4">
                                    <span class="badge" style="background-color: var(--cf2d-blue);">
                                        @(item.Pays?.Nom_pays ?? "Non défini")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
                            <div class="scroll-nav-buttons">
                                <button type="button" id="btnScrollTop" class="btn-scroll-nav" title="Prokrutit vverkh">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" id="btnScrollBottom" class="btn-scroll-nav" title="Prokrutit vniz">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </div>
        </div>
    </div>
</div>
