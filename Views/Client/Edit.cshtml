@model EcoLogistics.ViewModels.ClientBlock.ClientEditViewModel

@{
    ViewData["Title"] = "Modifier Client";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-cf2d"><i class="bi bi-pencil-square me-2"></i>Modification du Client</h2>
        <a asp-action="Details" asp-route-id="@Model.Id_client" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Annuler</a>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id_client" />
        <input type="hidden" asp-for="Id_siege" />
        <input type="hidden" asp-for="Id_p_contact" />
        <input type="hidden" asp-for="Id_adresse_exp" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- Entreprise -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-cf2d-header fw-bold">1. Informations Client</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label asp-for="Nom_entreprise" class="form-label fw-bold"></label>
                    <input asp-for="Nom_entreprise" class="form-control" />
                    <span asp-validation-for="Nom_entreprise" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Numero_entreprise" class="form-label"></label>
                    <input asp-for="Numero_entreprise" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="BE_entreprise" class="form-label"></label>
                    <input asp-for="BE_entreprise" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Telephone" class="form-label"></label>
                    <input asp-for="Telephone" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label asp-for="Adresse" class="form-label"></label>
                    <input asp-for="Adresse" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Id_localite" class="form-label"></label>
                    <select asp-for="Id_localite" asp-items="Model.LocaliteList" class="form-select">
                        <option value="">-- Sélectionner --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Id_user" class="form-label"></label>
                    <select asp-for="Id_user" asp-items="Model.UserList" class="form-select">
                        <option value="">-- Sélectionner --</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-center mt-4">
                    <div class="form-check">
                        <input asp-for="Is_deleted" class="form-check-input" type="checkbox" />
                        <label asp-for="Is_deleted" class="form-check-label text-danger fw-bold">Marquer comme supprimé/inactif</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Siège Social -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-cf2d-header fw-bold">2. Siège Social</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label asp-for="Siege_Raison_sociale" class="form-label"></label>
                    <input asp-for="Siege_Raison_sociale" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Siege_Adresse" class="form-label"></label>
                    <input asp-for="Siege_Adresse" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Siege_Site_internet" class="form-label"></label>
                    <input asp-for="Siege_Site_internet" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Siege_Secteur_activite" class="form-label"></label>
                    <input asp-for="Siege_Secteur_activite" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Siege_Id_localite" class="form-label"></label>
                    <select asp-for="Siege_Id_localite" asp-items="Model.LocaliteList" class="form-select">
                        <option value="">-- Sélectionner --</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Contact Principal -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-cf2d-header fw-bold">3. Contact Principal</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label asp-for="Contact_Nom" class="form-label"></label>
                    <input asp-for="Contact_Nom" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Contact_Email" class="form-label"></label>
                    <input asp-for="Contact_Email" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Contact_Telephone" class="form-label"></label>
                    <input asp-for="Contact_Telephone" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Contact_Gsm" class="form-label"></label>
                    <input asp-for="Contact_Gsm" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Contact_Id_localite" class="form-label"></label>
                    <select asp-for="Contact_Id_localite" asp-items="Model.LocaliteList" class="form-select">
                        <option value="">-- Sélectionner --</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Site -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-cf2d-header fw-bold">4. Site d'exploitation principal</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label asp-for="Site_Nom" class="form-label"></label>
                    <input asp-for="Site_Nom" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Site_Rue" class="form-label"></label>
                    <input asp-for="Site_Rue" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Site_Numero" class="form-label"></label>
                    <input asp-for="Site_Numero" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Site_Id_localite" class="form-label"></label>
                    <select asp-for="Site_Id_localite" asp-items="Model.LocaliteList" class="form-select">
                        <option value="">-- Sélectionner --</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="d-grid mb-5">
            <button type="submit" class="btn btn-warning btn-lg fw-bold"><i class="bi bi-save me-2"></i>Mettre à jour</button>
        </div>
    </form>
</div>