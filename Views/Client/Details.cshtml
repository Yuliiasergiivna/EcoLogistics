@model EcoLogistics.ViewModels.ClientBlock.ClientDetailViewModel

@{
    ViewData["Title"] = "Fiche Client - " + Model.Nom_entreprise;
    bool isAdminOrManager = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="container-fluid py-4">

    <!-- Header Page -->

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-cf2d mb-0">@Model.Nom_entreprise</h2>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary me-1"><i class="bi bi-arrow-left me-1"></i> Retour</a>
            @if (isAdminOrManager)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id_client" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Modifier</a>
                <form asp-action="ToggleSoftDelete" asp-route-id="@Model.Id_client" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer / désactiver ce client ?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-@(Model.Is_deleted ? "outline-success" : "outline-danger")">
                        <i class="bi bi-@(Model.Is_deleted ? "arrow-counterclockwise" : "trash") me-1"></i>
                        @(Model.Is_deleted ? "Restaurer" : "Supprimer")
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="row g-3">

        <!-- Informations Générales -->

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-cf2d-header fw-bold">
                    <i class="bi bi-info-circle me-2"></i>Informations Générales
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">N° BCE :</dt>
                        <dd class="col-sm-7">@(Model.Numero_entreprise ?? "-")</dd>

                        <dt class="col-sm-5">N° BE :</dt>
                        <dd class="col-sm-7">@(Model.BE_entreprise ?? "-")</dd>

                        <dt class="col-sm-5">Email général :</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                 <a href="mailto:@Model.Email">@Model.Email</a>
                            }else
                            {
                                <span>-</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Téléphone :</dt>
                        <dd class="col-sm-7">@(Model.Telephone ?? "-")</dd>

                        <dt class="col-sm-5">Adresse :</dt>
                        <dd class="col-sm-7">@(Model.Adresse ?? "-") @Model.Client_Code_postal @Model.Client_Nom_commune</dd>

                        <dt class="col-sm-5">Gestionnaire :</dt>
                        <dd class="col-sm-7">@(Model.User_Nom_complet ?? "Non assigné")</dd>

                        <dt class="col-sm-5">Statut :</dt>
                        <dd class="col-sm-7">
                            @if (Model.Is_deleted)
                            {
                                <span class="badge bg-danger">Inactif</span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: var(--cf2d-green);">Actif</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Siège Social -->

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-cf2d-header fw-bold">
                    <i class="bi bi-building me-2"></i>Siège Social (Juridique)
                </div>
                <div class="card-body">
                    @if (Model.Id_siege != null || !string.IsNullOrEmpty(Model.Siege_Raison_sociale))
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Raison Sociale :</dt>
                            <dd class="col-sm-7">@(Model.Siege_Raison_sociale ?? "-")</dd>

                            <dt class="col-sm-5">Adresse du siège :</dt>
                            <dd class="col-sm-7">@(Model.Siege_Adresse ?? "-")</dd>

                            <dt class="col-sm-5">Localité :</dt>
                            <dd class="col-sm-7">
                                @if(!string.IsNullOrEmpty(Model.Siege_Code_postal) || !string.IsNullOrEmpty(Model.Siege_Nom_localite))
                                {
                                    
                                    @($"{Model.Siege_Code_postal} {Model.Siege_Nom_localite} ({@Model.Siege_Nom_pays})")
                                }
                                else
                                {
                                    <span> - </span>
                                }
                            </dd>

                            <dt class="col-sm-5">Site Internet :</dt>
                            <dd class="col-sm-7">
                                @if (!string.IsNullOrEmpty(Model.Siege_Site_internet))
                                {
                                    <a href="@Model.Siege_Site_internet" target="_blank">@Model.Siege_Site_internet</a>
                                }
                                else
                                {

                                    <span>-</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Secteur :</dt>
                            <dd class="col-sm-7">@(Model.Siege_Secteur_activite ?? "-")</dd>
                        </dl>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <em>Aucun siège social enregistré pour ce client.</em>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Personnes de Contact -->

        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-cf2d-header fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-people me-2"></i>Personnes de Contact</span>

                    <div class="d-flex align-items-center gap-2">

                        @if (Model.PersonnesContact.Any(c => !string.IsNullOrEmpty(c.Email)))
                        {
                            <button type="button" id="sendEmailBtn" class="btn btn-sm btn-light text-dark fw-bold" disabled>
                                <i class="bi bi-envelope-at me-1"></i> Envoyer aux sélectionnés
                            </button>
                        }
                        @if (isAdminOrManager)
                        {
                            <a asp-controller="PersonneContact" asp-action="Create" asp-route-clientId="@Model.Id_client" 
                               class="btn btn-sm btn-light text-dark fw-bold" title="Ajouter un contact">
                                <i class="bi bi-plus-lg"></i> Ajouter
                            </a>
                        }

                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th style="width: 40px;" class="text-center">
                                    <input type="checkbox" id="selectAllContacts" class="form-check-input border-cfd2 shadow-none" 
                                            title="Tout sélectionner" style="border-color: var(--cf2d-blue, #0d6efd);border-width: 2px; border-style: solid; cursor: pointer"/>
                                </th>
                                <th>Nom et Prénom</th>
                                <th>Téléphone</th>
                                <th>GSM</th>
                                <th>Email</th>
                                <th>Localité</th>
                                @if (isAdminOrManager)
                                {
                                    <th class="text-center" style="width: 100px;">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PersonnesContact.Any())
                            {
                                <tr><td colspan="5" class="text-center py-3 text-muted"><em>Aucun contact enregistré.</em></td></tr>
                            }
                            else
                            {
                                @foreach (var c in Model.PersonnesContact)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(c.Email))
                                            {
                                                <input type="checkbox" class="form-check-input contact-checkbox" value="@c.Email" />
                                            }
                                        </td>
                                        <td class="fw-bold">@c.Nom</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(c.Telephone))
                                            {
                                                <a href="tel:@c.Telephone" class="text-decoration-none text-dark">@c.Telephone</a>
                                            }else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(c.Gsm))
                                            {
                                                <a href="tel:@c.Gsm" class="text-decoration-none text-dark">@c.Gsm</a>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(c.Email))
                                            {
                                                <a href="mailto:@c.Email">@c.Email</a>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>@(c.Localite_Info ?? "-")</td>
                                        @if (isAdminOrManager)
                                        {
                                            <td class="text-center">
                                                <div class="d-inline-flex gap-1" role="group">
                                                    <a asp-controller="PersonneContact" asp-action="Edit" asp-route-id="@c.Id_p_contact" 
                                                       class="btn btn-sm btn-outline-warning" title="Modifier">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form asp-controller="PersonneContact" asp-action="Delete" asp-route-id="@c.Id_p_contact" 
                                                          method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce contact ?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Adresses d'Exploitation -->

        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-cf2d-header fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-geo-alt me-2"></i>Sites d'Exploitation</span>
                    @if (isAdminOrManager)
                    {
                        <a asp-controller="AdresseExploitation" asp-action="Create" asp-route-clientId="@Model.Id_client"
                           class="btn btn-sm btn-light text-dark fw-bold" title="Ajouter un site">
                            <i class="bi bi-plus-lg"></i> Ajouter
                        </a>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Nom du Site</th>
                                <th>Rue et N°</th>
                                <th>Code Postal</th>
                                <th>Commune</th>
                                <th>Pays</th>
                                @if (isAdminOrManager)
                                {
                                    <th class="text-center" style="width: 100px;">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.AdressesExploitation.Any())
                            {
                                <tr><td colspan="@(isAdminOrManager ? 6:5)" class="text-center py-3 text-muted"><em>Aucun site d'exploitation enregistré.</em></td></tr>
                            }
                            else
                            {
                                @foreach (var s in Model.AdressesExploitation)
                                {
                                    <tr>
                                        <td class="fw-bold">@s.Nom_site</td>
                                        <td>@s.Rue @s.Numero</td>
                                        <td>@(s.Adresse_Code_postal ?? "-")</td>
                                        <td>@(s.Adresse_Commune ?? "-")</td>
                                        <td>@(s.Adresse_Pays ?? "-")</td>
                                        @if (isAdminOrManager)
                                        {
                                            <td class="text-center">
                                                <div class="d-inline-flex gap-1" role="group">

                                                    <a asp-controller="AdresseExploitation" asp-action="Edit" asp-route-id="@s.Id_adresse_exp" asp-route-clientId="@Model.Id_client"
                                                       class="btn btn-sm btn-outline-warning" title="Modifier">
                                                       <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form asp-controller="AdresseExploitation" asp-action="Delete" asp-route-id="@s.Id_adresse_exp" asp-route-clientId="@Model.Id_client"
                                                            metod="post" class="d-inline" onsubmit="return confirm ('Êtes-vous sûr de vouloir supprimer ce site ?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                    </form>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const selectAllCheckbox = document.getElementById("selectAllContacts");
            const contactCheckboxes = document.querySelectorAll(".contact-checkbox");
            const sendEmailBtn = document.getElementById("sendEmailBtn");

            function updateButtonState() {
                const checkedCount = document.querySelectorAll(".contact-checkbox:checked").length;
                if (sendEmailBtn) {
                    sendEmailBtn.disabled = checkedCount === 0;
                }
            }

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener("change", function () {
                    contactCheckboxes.forEach(cb => {
                        cb.checked = selectAllCheckbox.checked;
                    });
                    updateButtonState();
                });
            }

            contactCheckboxes.forEach(cb => {
                cb.addEventListener("change", function () {
                    updateButtonState();
                    if (selectAllCheckbox) {
                        selectAllCheckbox.checked = document.querySelectorAll(".contact-checkbox:checked").length === contactCheckboxes.length;
                    }
                });
            });

            if (sendEmailBtn) {
                sendEmailBtn.addEventListener("click", function () {
                    const selectedEmails = Array.from(document.querySelectorAll(".contact-checkbox:checked"))
                        .map(cb => cb.value)
                        .filter(email => email);

                    if (selectedEmails.length > 0) {
                       
                        const primaryEmail = selectedEmails[0];
                        const ccEmails = selectedEmails.slice(1).join(",");
                        
                        let mailtoLink = `mailto:${primaryEmail}`;
                        if (ccEmails) {
                            mailtoLink += `?cc=${encodeURIComponent(ccEmails)}`;
                        }

                        window.location.href = mailtoLink;
                    }
                });
            }
        });
    </script>
}