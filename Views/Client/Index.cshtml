@model IEnumerable<EcoLogistics.ViewModels.ClientBlock.ClientListViewModel>

@{
    ViewData["Title"] = "Répertoire des Clients";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-cf2d"><i class="bi bi-building me-2"></i>Répertoire des Clients</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Create" class="btn btn-cf2d fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Nouveau Client
            </a>
        }
    </div>

    <!-- Recherche-->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2">
                <div class="col-md-10">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                           class="form-control" placeholder="Rechercher par nom, N° BCE ou email..." />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-cf2d"><i class="bi bi-search me-1"></i> Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    <!--Tableau des clients  -->
    <div class="card shadow-sm border-0">
        <div class="top-scroll-wrapper border-bottom p-1">
            <div class="top-scroll-content"></div>
        </div>
@*         <div class="card-header bg-white border-0 py-2 d-md-none text-end">
            <span class="scroll-hint">
                <i class="bi bi-arrow-left-right me-1"></i> Glissez pour voir plus <i class="bi bi-arrows-arrows"></i>
            </span>
        </div> *@
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-cf2d-header text-center">
                        <tr>
                            <th>Entreprise / Raison Sociale</th>
                            <th>N° BCE</th>
                            <th>Contact Principal</th>
                            <th>Exploitation (Site)</th>
                            <th>Statut</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <em>Aucun client trouvé.</em>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.Is_deleted ? "table-secondary text-muted" : "")">
                                    <td class="fw-bold">
                                        <div>@item.Nom_entreprise</div>
                                        @if (!string.IsNullOrEmpty(item.Raison_sociale))
                                        {
                                            <small class="text-muted fw-normal">(@item.Raison_sociale)</small>
                                        }
                                    </td>
                                    <td class="text-center">@(item.Numero_entreprise ?? "-")</td>
                                    <td>
                                        <div><i class="bi bi-person me-1 text-cf2d"></i>@(item.Contact_nom ?? "-")</div>
                                        @if (!string.IsNullOrEmpty(item.Contact_gsm))
                                        {
                                            <small class="text-muted"><i class="bi bi-phone me-1"></i>@item.Contact_gsm</small>
                                        }
                                    </td>
                                    <td>
                                        <div>@(item.Production_nom_site ?? "-")</div>
                                        <small class="text-muted">@item.Production_code_postal @item.Production_commune</small>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Is_deleted)
                                        {
                                            <span class="badge bg-danger">Inactif / Supprimé</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: var(--cf2d-green);">Actif</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id_client"
                                               class="btn btn-outline-cf2d" title="Détails">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id_client"
                                                   class="btn btn-outline-warning" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <form asp-action="ToggleSoftDelete" asp-route-id="@item.Id_client"
                                                      method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger"
                                                            onclick="return confirm('Voulez-vous modifier le statut de ce client ?');"
                                                            title="Changer statut">
                                                        <i class="bi bi-power"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="scroll-nav-buttons">
    <button type="button" class="btn-scroll-nav" id="btnScrollTop" title="Haut de page">
        <i class="bi bi-arrow-up fs-5"></i>
    </button>
    <button type="button" class="btn-scroll-nav" id="btnScrollBottom" title="Bas de page">
        <i class="bi bi-arrow-down fs-5"></i>
    </button>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const topWrapper = document.querySelector('.top-scroll-wrapper');
            const topContent = document.querySelector('.top-scroll-content');
            const tableWrapper = document.querySelector('.table-responsive');
            const table = document.getElementById('clientsTable');

            function syncScrollWidth() {
                if (table && topContent) {
                    topContent.style.width = table.scrollWidth + 'px';
                }
            }

            syncScrollWidth();
            window.addEventListener('resize', syncScrollWidth);

            let isSyncingTop = false;
            let isSyncingTable = false;

            topWrapper.addEventListener('scroll', function() {
                if (!isSyncingTop) {
                    isSyncingTable = true;
                    tableWrapper.scrollLeft = topWrapper.scrollLeft;
                }
                isSyncingTop = false;
            });

            tableWrapper.addEventListener('scroll', function() {
                if (!isSyncingTable) {
                    isSyncingTop = true;
                    topWrapper.scrollLeft = tableWrapper.scrollLeft;
                }
                isSyncingTable = false;
            });

            // --- 2. Flech en bas/ en haut ---
            document.getElementById('btnScrollTop').addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            document.getElementById('btnScrollBottom').addEventListener('click', function() {
                window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
            });
            const searchInput = document.querySelector('input[name="searchString"]');
            const tableRows = document.querySelectorAll("tbody tr");

            searchInput.addEventListener("input", function () {
                const query = this.value.toLowerCase().trim();

                tableRows.forEach(row => {
                    // Propuskayem stroku, esli klienty ne naydeny
                    if (row.cells.length === 1) return;

                    const text = row.textContent.toLowerCase();
                    
                    if (text.includes(query)) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            });
        });
    </script>
}