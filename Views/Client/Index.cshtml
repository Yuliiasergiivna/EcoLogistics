@model IEnumerable<EcoLogistics.ViewModels.ClientBlock.ClientListViewModel>

@{
    ViewData["Title"] = "Répertoire des Clients";
    bool isAdminOrManager = User.IsInRole("Admin") || User.IsInRole("Manager");
    var currentStatus = ViewData["StatusFilter"]?.ToString() ?? "actifs";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-cf2d"><i class="bi bi-building me-2"></i>Répertoire des Clients</h2>

        @if (isAdminOrManager)
        {
            <a asp-action="Create" class="btn btn-cf2d fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Nouveau Client
            </a>
        }
    </div>

    <!-- Recherche et Filtre-->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <!-- Dobavlen id="searchForm" -->
            <form method="get" asp-action="Index" class="row g-2 align-items-center" id="searchForm">
                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <!-- Dobavlen id="searchInput" -->
                        <input type="text" id="searchInput" name="searchString" value="@ViewData["CurrentFilter"]"
                               class="form-control border-start-0 border-end-0 shadow-none" placeholder="Rechercher par nom..." />

                        <!-- Krestik dlya ochistki -->
                        <button type="button" id="clearSearchBtn" class="btn btn-white border border-start-0 text-muted bg-white @(string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()) ? "d-none" : "")" title="Effacer">
                            <i class="bi bi-x-lg"></i>
                        </button>

                        <!-- Knopka otpravki poiska -->
                        <button type="submit" class="btn btn-outline-secondary" title="Rechercher">
                            <i class="bi bi-arrow-return-left"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-5">
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="actifs" selected="@(currentStatus == "actifs")">📁 Clients Actifs</option>
                        <option value="inactifs" selected="@(currentStatus == "inactifs")">🗑️ Clients Inactifs</option>
                        <option value="tous" selected="@(currentStatus == "tous")">🌐 Tous les clients</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!--Tableau épuré (2 colonnes clés)  -->
    <div class="card shadow-sm border-0">
        <div class="top-scroll-wrapper border-bottom p-1">
            <div class="top-scroll-content"></div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="clientsTable" class="table table-hover align-middle mb-0">
                    <thead class="bg-cf2d-header text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">N° Client</th>
                            <th class="ps-4">Entreprise / Raison Sociale</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    <em>Aucun client trouvé.</em>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.Is_deleted ? "table-secondary text-muted" : "") shadow-hover" style="transition: all 0.2s ease; cursor: pointer;">
                                    <td class="ps-4 fw-bold text-secondary">
                                        @(item.Numero_client ?? "-")
                                    </td>
                                    <td class="ps-4 py-3">
                                        <a asp-action="Details" asp-route-id="@item.Id_client" class="text-decoration-none fw-bold text-dark fs-6"
                                           style="color:var(--cf2d-blue, #0d6efd);">
                                            @item.Nom_entreprise
                                        </a>
                                        @if (!string.IsNullOrEmpty(item.Raison_sociale))
                                        {
                                            <div class="text-muted small">@item.Raison_sociale</div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="scroll-nav-buttons">
    <button type="button" class="btn-scroll-nav" id="btnScrollTop" title="Haut de page">
        <i class="bi bi-arrow-up fs-5"></i>
    </button>
    <button type="button" class="btn-scroll-nav" id="btnScrollBottom" title="Bas de page">
        <i class="bi bi-arrow-down fs-5"></i>
    </button>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Status filter auto-submit (ostalyesya dlya select-a)
            const statusSelect = document.querySelector('select[name="statusFilter"]');
            if (statusSelect) {
                statusSelect.addEventListener("change", function () {
                    this.form.submit();
                });
            }

            // 2. Clickable table rows
            const rows = document.querySelectorAll("table.table tbody tr");
            rows.forEach(row => {
                if (row.cells.length <= 1) return;

                row.style.cursor = "pointer";
                row.addEventListener("click", function (e) {
                    if (e.target.closest("a") || e.target.closest("button") || e.target.closest("form")) {
                        return;
                    }
                    const detailsLink = row.querySelector("a[href*='Details']");
                    if (detailsLink) {
                        window.location.href = detailsLink.href;
                    }
                });
            });

            // 3. Horizontal scroll synchronization
            const topWrapper = document.querySelector('.top-scroll-wrapper');
            const topContent = document.querySelector('.top-scroll-content');
            const tableWrapper = document.querySelector('.table-responsive');
            const table = document.getElementById('clientsTable');

            function syncScrollWidth() {
                if (table && topContent) {
                    topContent.style.width = table.scrollWidth + 'px';
                }
            }

            syncScrollWidth();
            window.addEventListener('resize', syncScrollWidth);

            let isSyncingTop = false;
            let isSyncingTable = false;

            if (topWrapper && tableWrapper) {
                topWrapper.addEventListener('scroll', function () {
                    if (!isSyncingTop) {
                        isSyncingTable = true;
                        tableWrapper.scrollLeft = topWrapper.scrollLeft;
                    }
                    isSyncingTop = false;
                });

                tableWrapper.addEventListener('scroll', function () {
                    if (!isSyncingTable) {
                        isSyncingTop = true;
                        topWrapper.scrollLeft = tableWrapper.scrollLeft;
                    }
                    isSyncingTable = false;
                });
            }

            // 4. Scroll to top / bottom buttons
            const btnScrollTop = document.getElementById('btnScrollTop');
            const btnScrollBottom = document.getElementById('btnScrollBottom');

            if (btnScrollTop) {
                btnScrollTop.addEventListener('click', function () {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
            if (btnScrollBottom) {
                btnScrollBottom.addEventListener('click', function () {
                    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
                });
            }

            // 5. «ZHIVOY» POISK + KRESTIK OCHISTKI (Client-side filtering)
            const searchInput = document.getElementById("searchInput");
            const clearSearchBtn = document.getElementById("clearSearchBtn");
            const tableRows = document.querySelectorAll("#clientsTable tbody tr");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    const query = this.value.toLowerCase().trim();

                    // Pokazyvaem ili skryvaet krestik
                    if (query.length > 0) {
                        clearSearchBtn.classList.remove("d-none");
                    } else {
                        clearSearchBtn.classList.add("d-none");
                    }

                    // Zhivaya filtratsiya strok v tablitse
                    tableRows.forEach(row => {
                        if (row.cells.length <= 1) return; // propuskaem stroku "Aucun client trouvé"

                        const text = row.textContent.toLowerCase();
                        if (text.includes(query)) {
                            row.style.display = ""; // pokazyvaem stroku
                        } else {
                            row.style.display = "none"; // skryvaem stroku
                        }
                    });
                });
            }

            if (clearSearchBtn) {
                clearSearchBtn.addEventListener("click", function () {
                    searchInput.value = "";
                    clearSearchBtn.classList.add("d-none");

                    // Vozvrashchaem vse stroki obratno
                    tableRows.forEach(row => {
                        if (row.cells.length <= 1) return;
                        row.style.display = "";
                    });
                });
            }
        });
    </script>
}