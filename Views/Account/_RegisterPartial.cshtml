@model EcoLogistics.ViewModels.UserBlock.RegisterViewModel

<form asp-controller="Account" asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <h5 class="text-cf2d border-bottom pb-2 mb-3">Identifiants de connexion</h5>

    <div class="mb-3">
        <label asp-for="Email" class="form-label fw-bold"></label>
        <input asp-for="Email" class="form-control" placeholder="exemple@ecologistics.be" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nickname" class="form-label fw-bold"></label>
        <input asp-for="Nickname" class="form-control" placeholder="MonPseudo" />
        <span asp-validation-for="Nickname" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Password" class="form-label fw-bold"></label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>

    <h5 class="text-cf2d border-bottom pb-2 mt-4 mb-3 fw-bold">Informations personnelles</h5>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Nom" class="form-label fw-bold"></label>
            <input asp-for="Nom" class="form-control" />
            <span asp-validation-for="Nom" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Prenom" class="form-label fw-bold"></label>
            <input asp-for="Prenom" class="form-control" />
            <span asp-validation-for="Prenom" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Poste" class="form-label fw-bold"></label>
        <input asp-for="Poste" class="form-control" placeholder="Ex: Chauffeur, Gestionnaire..." />
        <span asp-validation-for="Poste" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Adresse" class="form-label fw-bold"></label>
        <input asp-for="Adresse" class="form-control" placeholder="Rue et numéro" />
        <span asp-validation-for="Adresse" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Id_localite" class="form-label fw-bold"></label>
        <select asp-for="Id_localite" asp-items="ViewBag.Localites" class="form-select">
            <option value="">-- Sélectionnez une localité --</option>
        </select>
        <span asp-validation-for="Id_localite" class="text-danger"></span>
    </div>

    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-cf2d btn-lg">S'inscrire</button>
    </div>
</form>