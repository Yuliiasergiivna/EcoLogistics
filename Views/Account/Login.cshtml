@model EcoLogistics.ViewModels.UserBlock.LoginViewModel

@{
    ViewData["Title"] = "Connexion";
}

<style>
    :root {
        --cf2d-green: #68A63C;
        --cf2d-blue: #1B75BC;
        --cf2d-dark: #2B3A42;
    }

    .cf2d-card {
        border: none;
        border-radius: 12px;
    }

    .cf2d-title {
        color: var(--cf2d-dark);
        font-weight: 700;
    }

    .cf2d-badge {
        background-color: #EAF4E1;
        color: var(--cf2d-green);
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 14px;
        border-radius: 20px;
        display: inline-block;
    }

    .btn-cf2d-primary {
        background-color: var(--cf2d-blue);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

    .btn-cf2d-primary:hover {
        background-color: #145A93;
        color: #fff;
    }

    .cf2d-link {
        color: var(--cf2d-green);
    }

    .cf2d-link:hover {
        color: #4E822B;
    }

    .form-control:focus {
        border-color: var(--cf2d-green);
        box-shadow: 0 0 0 0.25rem rgba(104, 166, 60, 0.25);
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg cf2d-card">
                <div class="card-body p-4 p-md-5">
                    <!-- Header avec badge et titre -->
                    <div class="text-center mb-4">
                        <span class="cf2d-badge mb-2">
                            <i class="bi bi-recycle me-1"></i> Économie sociale & circulaire
                        </span>
                        <h2 class="h3 cf2d-title mt-2">Espace de Connexion</h2>
                        <p class="text-muted small">Plateforme de gestion EcoLogistics</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold text-secondary"></label>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="exemple@ecologistics.be" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold text-secondary"></label>
                            <input asp-for="Password" class="form-control form-control-lg" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-muted"></label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-cf2d-primary btn-lg">Se connecter</button>
                        </div>
                    </form>
                </div>

                <div class="card-footer text-center py-3 bg-light border-0 rounded-bottom-4">
                   @*  <h3 class="h4 mb-0">Se connecter</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" placeholder="exemple@ecologistics.be" autofocus />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Connexion</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3"> *@
                    <span class="text-muted">Vous n'avez pas encore de compte ?</span>
                    <a asp-controller="Account" asp-action="Register" class="cf2d-link text-decoration-none fw-bold ms-1">S'inscrire</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}