@model IEnumerable<EcoLogistics.ViewModels.Catalogues.CatalogueItemViewModel>

@{
    ViewData["Title"] = "Gestion des Catalogues";
    var currentType = ViewData["CurrentType"]?.ToString() ?? "Marques";
    var isEditable = (bool)(ViewData["IsEditable"] ?? false);
    var currentFilter = ViewData["CurrentFilter"]?.ToString();
    var catalogDisplayName = ViewData["CatalogDisplayName"]?.ToString() ?? "Marques";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Gestion des Catalogues</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 bg-transparent p-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Accueil</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Catalogue" asp-action="Index" asp-route-type="Marques" class="text-decoration-none">Catalogues</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">@catalogDisplayName</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Вкладки переключения между каталогами -->
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <ul class="nav nav-pills gap-2">
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill @(currentType == "Marques" ? "text-white" : "text-dark bg-light")"
                       style="@(currentType == "Marques" ? "background-color: var(--cf2d-blue);" : "")" asp-action="Index" asp-route-type="Marques">Marques</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill @(currentType == "Divers" ? "text-white" : "text-dark bg-light")" 
                       style="@(currentType == "Divers" ? "background-color: var(--cf2d-blue);" : "")" asp-action="Index" asp-route-type="Divers">Divers</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill @(currentType == "Poids" ? "text-white" : "text-dark bg-light")" 
                       style="@(currentType == "Poids" ? "background-color: var(--cf2d-blue);" : "")" asp-action="Index" asp-route-type="Poids">Poids</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill @(currentType == "CodeEURAL" ? "text-white" : "text-dark bg-light")" 
                       style="@(currentType == "CodeEURAL" ? "background-color: var(--cf2d-blue);" : "")" asp-action="Index" asp-route-type="CodeEURAL">Codes EURAL</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill @(currentType == "CodeDR" ? "text-white" : "text-dark bg-light")" 
                       style="@(currentType == "CodeDR" ? "background-color: var(--cf2d-blue);" : "")" asp-action="Index" asp-route-type="CodeDR">Codes DR</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Панель поиска и кнопки добавления -->
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <form method="get" asp-action="Index" class="row g-2">
                        <input type="hidden" name="type" value="@currentType" />
                        <div class="col-md-9">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" name="searchString" value="@currentFilter" class="form-control border-start-0 ps-0" placeholder="Rechercher dans @currentType..." />
                            </div>
                        </div>
                        <div class="col-md-3 d-grid">
                            <button type="submit" class="btn btn-cf2d"><i class="bi bi-search me-1"></i> Rechercher</button>
                        </div>
                    </form>
                </div>
                <div class="col-md-4 text-end">
                    @if (isEditable)
                    {
                        <a asp-action="Create" asp-route-type="@currentType" class="btn btn-success rounded-pill px-3">
                            <i class="bi bi-plus-circle me-1"></i> Ajouter un élément
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2 fw-normal">Catalogue officiel (Lecture seule)</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Таблица данных -->
    <div class="card shadow-sm border-0 mb-4 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="ps-4 py-3">Nom / Code / Désignation</th>
                            <th class="py-3">Description / Détails</th>
                            @if (currentType == "Poids")
                            {
                                <th class="py-3">Valeur (kg)</th>
                            }
                            @if (isEditable)
                            {
                                <th class="text-end pe-4 py-3" style="width: 150px;">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@item.Name</td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)</td>
                                    @if (currentType == "Poids")
                                    {
                                        <td class="fw-semibold">@(item.PoidsValeur.HasValue ? item.PoidsValeur.Value.ToString("N2") + " kg" : "—")</td>
                                    }
                                    @if (isEditable)
                                    {
                                        <td class="text-end pe-4">
                                            <a asp-action="Edit" asp-route-type="@currentType" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1 rounded-circle" title="Modifier" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-type="@currentType" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Supprimer" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(isEditable ? (currentType == "Poids" ? 4 : 3) : (currentType == "Poids" ? 3 : 2))" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Aucun élément trouvé dans ce catalogue.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>