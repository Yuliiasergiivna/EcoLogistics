@model IEnumerable<EcoLogistics.Models.Catalogues.CodeEURAL>

@{
    ViewData["Title"] = "Gestion des Codes EURAL";
    var currentFilter = ViewData["CurrentFilter"]?.ToString();
    var activeCodes = ViewData["ActiveCodes"] as List<EcoLogistics.Models.Catalogues.CodeEURAL> ?? new ();
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="container-fluid px-4">

    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Gestion des Catalogues</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 bg-transparent p-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Accueil</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Catalogue" asp-action="Index" asp-route-type="Marques" class="text-decoration-none">Catalogues</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Codes EURAL</li>
                </ol>
            </nav>
        </div>
    </div>


    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <ul class="nav nav-pills gap-2">
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill text-dark bg-light" asp-action="Index" asp-route-type="Marques">Marques</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill text-dark bg-light" asp-action="Index" asp-route-type="Divers">Divers</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill text-dark bg-light" asp-action="Index" asp-route-type="Poids">Poids</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill text-white" style="background-color: var(--cf2d-blue) !important;" asp-action="Index" asp-route-type="CodeEURAL">Codes EURAL</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-pill text-dark bg-light" asp-action="Index" asp-route-type="CodeDR">Codes DR</a>
                </li>
            </ul>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4 rounded-4 overflow-hidden">
        <div class="card-header bg-cf2d-header py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold fs-6">
                <i class="bi bi-star-fill text-warning me-2"></i>Codes EURAL actifs 
            </h5>
            <span class="badge bg-light text-dark">@activeCodes.Count éléments</span>
        </div>

        <div class="card-body p-4 bg-white border-bottom">
            @if (canEdit)
            {
                <form asp-action="CreateEural" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Matériel / Description</label>
                        <input type="text" name="description" class="form-control form-control-sm" placeholder="Ex: UC / Serveur" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Code "IBGE" *</label>
                        <input type="text" name="code_IBGE" class="form-control form-control-sm" placeholder="Ex: 20 01 35" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary mb-1">Code EURAL *</label>
                        <input type="text" name="code_EURAL" class="form-control form-control-sm" placeholder="Ex: 20 01 35*" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary mb-1">Traitement (Directive)</label>
                        <input type="text" name="directive_ref" class="form-control form-control-sm" placeholder="Ex: R12" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Ajouter
                        </button>
                    </div>
                </form>
            }
        </div>

        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 table-sm">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 0.78rem;">
                        <tr>
                            <th class="ps-4 py-2">Matériel / Description</th>
                            <th class="py-2">Code "IBGE"</th>
                            <th class="py-2">Code EURAL</th>
                            <th class="py-2">Traitement</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (activeCodes.Any())
                        {
                            foreach (var item in activeCodes)
                            {
                                var editUrl = Url.Action("EditEural", "Catalogue", new { id = item.Id_code_EURAL });
                                <tr class="@(canEdit ? "eural-row-edit" : "")"
                                    style="@(canEdit ? "cursor: pointer;" : "")"
                                    @if (canEdit)
                                    {
                                             <text>data-edit-url="@editUrl"</text>
                                    }>
                                    <td class="ps-4 fw-bold text-cf2d">@(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)</td>
                                    <td class="fw-semibold">@(string.IsNullOrEmpty(item.Code_IBGE) ? "—" : item.Code_IBGE)</td>
                                    <td><span class="badge bg-light text-dark border">@item.Code_EURAL</span></td>
                                    <td class="pe-4 fw-bold">@(string.IsNullOrEmpty(item.Directive_ref) ? "—" : item.Directive_ref)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4 small">
                                    Aucun code actif configuré. Utilisez le formulaire ci-dessus pour en ajouter.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
            <h5 class="mb-0 fw-bold fs-6 text-dark">
                <i class="bi bi-journal-bookmark me-2 text-cf2d"></i>Catalogue Officiel Complet (Informatif)
            </h5>

            <!-- Poisk po vsemu spravochniku -->
            <form method="get" asp-action="Index" class="d-flex gap-2" style="max-width: 350px; width: 100%;">
                <input type="hidden" name="type" value="CodeEURAL" />
                <input type="text" name="searchString" value="@currentFilter" class="form-control form-control-sm" placeholder="Rechercher un code ou libellé..." />
                <button type="submit" class="btn btn-cf2d btn-sm px-3"><i class="bi bi-search"></i></button>
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 table-sm">
                    <thead class="table-light text-uppercase text-secondary sticky-top" style="font-size: 0.78rem;">
                        <tr>
                            <th class="ps-4 py-2" style="width: 140px;">Code EURAL</th>
                            <th class="py-2" style="width: 140px;">Code IBGE</th>
                            <th class="py-2">Description officielle</th>
                            <th class="pe-4 py-2" style="width: 150px;">Directive / Ref</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-cf2d">@item.Code_EURAL</td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(item.Code_IBGE) ? "—" : item.Code_IBGE)</td>
                                    <td class="text-dark">@(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)</td>
                                    <td class="pe-4 text-muted">@(string.IsNullOrEmpty(item.Directive_ref) ? "—" : item.Directive_ref)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Aucun code trouvé dans le catalogue officiel.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("tr.eural-row-edit[data-edit-url]").forEach(function (row) {
                row.addEventListener("click", function (e) {
                    if (e.target.closest("a, button, form, input")) {
                        return;
                    }
                    const rawUrl = this.getAttribute("data-edit-url");
                    const url = rawUrl ? rawUrl.replaceAll('"', '').trim() : "";
                    if (url) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}