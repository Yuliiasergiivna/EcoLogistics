<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoLogistics - CF2D </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcoLogistics.styles.css" asp-append-version="true" />

</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- PANNEAU SUPÉRIEUR (Affiché uniquement aux utilisateurs autorisés) -->
        <nav class="navbar navbar-dark navbar-cf2d px-3 py-2">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="CF2D Logo" height="70" class="bg-white p-1 rounded" />
                <span class="fs-4">EcoLogistics</span>
            </a>
            <div class="d-flex align-items-center text-white">
                <span class="me-3"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Déconnexion</button>
                </form>
            </div>
        </nav>

        <!-- INTERFACE PRINCIPALE AVEC MENU À GAUCHE -->
        <div class="container-fluid">
            <div class="row">
                <!-- Menu d'accompagnement -->
                <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-0">
                    <div class="position-sticky pt-3">
                        <div class="menu-header"><i class="bi bi-house-door me-1"></i> MENU PRINCIPAL</div>

                        <!-- USER SECTION -->
                      
 @*                            <a asp-controller="User" asp-action="Index">Utilisateurs</a> *@
                            @if(User.IsInRole("Admin") )
                                {
                            <div class="menu-header"><i class="bi bi-people me-1"></i>User</div>
                            <div class="sub-menu">
                                    <a asp-controller="User" asp-action="Profile"><i class="bi bi-person-badge me-1"></i>Données perso</a>
                                    <a asp-controller="Conducteur" asp-action="Index"><i class="bi bi-truck me-1"></i> Chauffeurs</a>
                            </div>
                                }
                        

                        <!-- GEO SECTION -->
                        <div class="menu-header"><i class="bi bi-globe me-1"></i>Geo</div>
                        <div class="sub-menu">
                            <a asp-controller="Geo" asp-action="Index"><i class="bi bi-map me-1"></i>Localités & Pays</a>
                        </div>

                        <!-- CLIENT SECTION -->
                        <div class="menu-header"><i class="bi bi-building me-1"></i> Client</div>
                        <div class="sub-menu">
                            <a asp-controller="Client" asp-action="Index"><i class="bi bi-briefcase me-1"></i> Entreprises</a>
                            <a asp-controller="PersonneContact" asp-action="Index"><i class="bi bi-person-lines-fill me-1"></i> Personnes de contact</a>
                            <a asp-controller="SiegeSocial" asp-action="Index"><i class="bi bi-geo-alt me-1"></i> Sièges sociaux</a>
                            <a asp-controller="AdresseExploitation" asp-action="Index"><i class="bi bi-pin-map me-1"></i> Adresses d'exploitation</a>
                        </div>

                        <!-- PRODUIT & CATALOGUES SECTION -->
                        <div class="menu-header"><i class="bi bi-box-seam me-1"></i> Produit</div>
                        <div class="sub-menu">
                            <a asp-controller="Produit" asp-action="Index"><i class="bi bi-box me-1"></i> Produits</a>
                            <a asp-controller="Colis" asp-action="Index"><i class="bi bi-archive me-1"></i> Colis</a>
                            <a asp-controller="Catalogues" asp-action="Index"><i class="bi bi-journal-text me-1"></i> Catalogues (EURAL / DR / Divers)</a>
                        </div>

                        <!-- LOGISTIQUE SECTION -->
                        <div class="menu-header"><i class="bi bi-arrow-repeat me-1"></i> Logistique</div>
                        <div class="sub-menu">
                            <a asp-controller="Enlevement" asp-action="Index"><i class="bi bi-receipt-cutoff me-1"></i> Enlèvements</a>
                        </div>
                    </div>
                </nav>

                <!-- Contenu de la page après connexion -->
                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- ÉCRAN DE CONNEXION (Pour les utilisateurs non autorisés - centre transparent) -->
        <main role="main" class="container py-5">
            @RenderBody()
        </main>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EcoLogistics - Fait par Krempolska Yuliia <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
