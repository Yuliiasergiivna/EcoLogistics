<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoLogistics </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcoLogistics.styles.css" asp-append-version="true" />
    <style>
            body {
                min-height: 100vh;
                background-color: #f8f9fa;
            }

            .sidebar {
                min-height: calc(100vh - 56px);
                background-color: #2c3e50;
                color: #fff;
            }

                .sidebar a {
                    color: #ecf0f1;
                    text-decoration: none;
                    display: block;
                    padding: 8px 16px;
                    font-size: 0.9rem;
                }

                    .sidebar a:hover {
                        background-color: #34495e;
                        color: #fff;
                    }

                .sidebar .menu-header {
                    font-weight: bold;
                    padding: 12px 16px 4px;
                    font-size: 0.85rem;
                    color: #bdc3c7;
                    text-transform: uppercase;
                }

                .sidebar .sub-menu {
                    padding-left: 15px;
                }
    </style>
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- PANNEAU SUPÉRIEUR (Affiché uniquement aux utilisateurs autorisés) -->
        <nav class="navbar navbar-dark bg-dark px-3">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">EcoLogistics</a>
            <div class="d-flex align-items-center text-white">
                <span class="me-3"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Déconnexion</button>
                </form>
            </div>
        </nav>

        <!-- INTERFACE PRINCIPALE AVEC MENU À GAUCHE -->
        <div class="container-fluid">
            <div class="row">
                <!-- Menu d'accompagnement -->
                <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-0">
                    <div class="position-sticky pt-3">
                        <div class="menu-header"> MENU PRINCIPAL</div>

                        <div class="menu-header">User</div>
                        <div class="sub-menu">
 @*                            <a asp-controller="User" asp-action="Index">Utilisateurs</a> *@
                            @if(User.IsInRole("Admin") )
                                {
                                <a asp-controller="User" asp-action="Profile">Données perso</a>
                                }
                            <a asp-controller="Conducteur" asp-action="Index"> Conducteurs</a>
                        </div>

                        <div class="menu-header">🌍Geo</div>
                        <div class="sub-menu">
                            <a asp-controller="Geo" asp-action="Index">Localités & Pays</a>
                        </div>
                    </div>
                </nav>

                <!-- Contenu de la page après connexion -->
                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- ÉCRAN DE CONNEXION (Pour les utilisateurs non autorisés - centre transparent) -->
        <main role="main" class="container py-5">
            @RenderBody()
        </main>
    }
 @*    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EcoLogistics</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="User" asp-action="Profile">Données Personnelles</a>
                            </li>
                        }
    @*                     <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li> *@
@*                     </ul>
                    <!--  Logout / Connexion  -->
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                    <button type="submit" class="btn btn-link nav-link text-danger border-0">Déconnexion</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Connexion</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div> *@ 

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EcoLogistics - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
