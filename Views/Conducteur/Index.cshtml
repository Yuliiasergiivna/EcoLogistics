@model IEnumerable<EcoLogistics.ViewModels.UserBlock.ConducteurListViewModel>

@{
    ViewData["Title"] = "Gestion des Conducteurs";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 fw-bold text-dark">
        <i class="bi bi-truck text-primary me-2"></i>Liste des Conducteurs
    </h2>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i>Ajouter un conducteur
        </a>
    }
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">@Html.DisplayNameFor(model => model.N_plaque)</th>
                        <th>@Html.DisplayNameFor(model => model.NomConducteur)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Quantite_Npalette)</th>
                        @if (isAdmin)
                        {
                            <th class="text-end px-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 4 : 3)" class="text-center py-4 text-muted">
                                Aucun conducteur enregistré.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">
                                    <span class="badge bg-outline-dark border text-dark fs-6 px-3 py-2">
                                        @item.N_plaque
                                    </span>
                                </td>
                                <td>
                                    <i class="bi bi-person-circle me-1 text-secondary"></i>
                                    @item.NomConducteur
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark fs-6 px-3">
                                        @item.Quantite_Npalette
                                    </span>
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="text-end px-4">
                                        <a asp-action="Edit" asp-route-id="@item.Id_conducteur" class="btn btn-sm btn-outline-warning me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id_conducteur" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce conducteur ?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
