@model EcoLogistics.ViewModels.UserBlock.ConducteurFormViewModel

@{
    ViewData["Title"] = "Modifier le conducteur";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-warning text-dark py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Modifier le conducteur</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id_conducteur" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="N_plaque" class="form-label fw-bold"></label>
                    <input asp-for="N_plaque" class="form-control" />
                    <span asp-validation-for="N_plaque" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantite_Npalette" class="form-label fw-bold"></label>
                    <input asp-for="Quantite_Npalette" type="number" class="form-control" />
                    <span asp-validation-for="Quantite_Npalette" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Id_perso" class="form-label fw-bold"></label>
                    <select asp-for="Id_perso" class="form-select" asp-items="ViewBag.Employes">
                        <option value="">-- Sélectionner un employé --</option>
                    </select>
                    <span asp-validation-for="Id_perso" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-warning px-4">Mettre à jour</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
